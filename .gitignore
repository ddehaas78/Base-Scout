# your saved seeds stay on your computer
seeds.txt
# cubiomes, downloaded by sources/wasm/build-wasm.sh when the generator is recompiled
sources/wasm/cubiomes/
# the game's language files, downloaded only to rebuild the translations (sources/i18n/game.py, jobs.py)
sources/i18n/lang/
# Python's cache when the build scripts run
__pycache__/
*.pyc
# a copy of the game, if one is ever put here to read how it works
_mc/
# system files
Thumbs.db
desktop.ini
.DS_Store
